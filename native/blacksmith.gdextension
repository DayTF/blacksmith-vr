[configuration]
entry_symbol = "blacksmith_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/libblacksmith_native.so"
linux.release.x86_64 = "res://native/bin/libblacksmith_native.so"
windows.debug.x86_64 = "res://native/bin/blacksmith_native.dll"
windows.release.x86_64 = "res://native/bin/blacksmith_native.dll"
